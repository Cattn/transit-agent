# API base URL. When set, it always wins. Without it, getApiUrl() (src/platform) uses the LAN
# address Expo serves from (a real phone on the same Wi-Fi), else 10.0.2.2 on the Android emulator
# and localhost on iOS. Once App.tsx uses getApiUrl(), delete this line to test on a real phone.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

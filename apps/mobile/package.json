{
  "name": "@transit/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "tunnel": "expo start --go --tunnel",
    "dev:client": "expo start --dev-client",
    "build": "expo export --platform android --platform ios",
    "build:android": "npx --yes eas-cli@27.10.0 build --platform android --profile development",
    "build:preview": "npx --yes eas-cli@27.10.0 build --platform android --profile preview",
    "build:ios": "npx --yes eas-cli@27.10.0 build --platform ios --profile development",
    "eas-build-post-install": "npm run build -w @transit/shared && npm run build -w @transit/maps && npm run build -w @transit/client-react",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test:unit": "vitest run",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.28",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@transit/client-react": "*",
    "@transit/maps": "*",
    "@transit/shared": "*",
    "expo": "~58.0.25",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "expo-doctor": "^1.21.8",
    "vitest": "^4.1.12"
  }
}

{
  "name": "@transit/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@transit/shared": "*",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "vitest": "^4.1.12"
  }
}

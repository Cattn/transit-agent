HOST=0.0.0.0
PORT=3001
CORS_ORIGIN=http://localhost:5173
GAS_USD_PER_GALLON=3.20
DATABASE_PATH=./data/transit-agent.db

# Route providers: fixture (default, offline demo data) or transitous (live public routing, light use only). Never both.
ROUTE_PROVIDERS=fixture
TRANSITOUS_URL=https://api.transitous.org
# Required for transitous: identify the app and a contact, e.g. transit-agent/0.1 (you@example.com)
ROUTING_USER_AGENT=

# Photon place search: public demo server, light use only; leave empty to use the built-in place list
PHOTON_URL=https://photon.komoot.io

GEMINI_API_KEY=
# Or use Vertex AI with Application Default Credentials (gcloud auth application-default login) instead of a key:
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
AGENT_MODEL_PLANNER=
# Planner thinking level: LOW (default), MEDIUM or HIGH
AGENT_THINKING_PLANNER=

{
  "name": "@transit/maps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./samples": {
      "types": "./dist/samples.d.ts",
      "default": "./dist/samples.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "demo": "vite --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo",
    "test:unit": "vitest run",
    "test": "npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@transit/shared": "*"
  },
  "peerDependencies": {
    "maplibre-gl": ">=6",
    "react": ">=19",
    "react-map-gl": ">=8"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": { "optional": true },
    "react": { "optional": true },
    "react-map-gl": { "optional": true }
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "maplibre-gl": "^6.18.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "^8.1.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
